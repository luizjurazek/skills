# Copy to .env (gitignored) and fill in.

# Spreadsheet ID: the long string in https://docs.google.com/spreadsheets/d/<ID>/edit
SPREADSHEET_ID=
# Tab name inside the spreadsheet
SHEET_NAME=Resultados

# Path to the service account key (relative paths resolve from this folder)
GOOGLE_APPLICATION_CREDENTIALS=credentials/service-account.json

# Where the Obsidian projects live (read by the skill, not by the script)
OBSIDIAN_PROJECTS_DIR=/home/jurazek/Documents/repositories/obsidian/projects
